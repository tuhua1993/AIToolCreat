<navigator wx:if="{{guide && url}}" class="card {{illustrated ? 'illustrated' : ''}}" url="{{url}}" hover-class="pressed">
  <view wx:if="{{illustrated}}" class="card-cover">
    <view wx:if="{{guide.cover.device === 'laptop'}}" class="laptop">
      <image class="laptop-screen" src="{{guide.cover.src}}" mode="aspectFill" aria-label="{{guide.cover.alt}}" />
      <view class="laptop-base"></view>
    </view>
    <image wx:elif="{{guide.cover}}" class="cover-photo" src="{{guide.cover.src}}" aria-label="{{guide.cover.alt}}" mode="aspectFill" />
    <image wx:else class="cover-icon" src="/assets/{{guide.topic.icon}}.png" mode="aspectFit" />
  </view>
  <view class="card-main">
    <view class="card-meta" wx:if="{{!illustrated}}">
      <text class="tag {{guide.topic.tone}}">{{guide.topic.name}}</text>
      <text>{{guide.time}} 分钟</text>
      <text wx:if="{{showDate && guide.updatedOn}}">{{guide.updatedOn}} 更新</text>
    </view>
    <view class="card-title">{{guide.title}}</view>
    <view class="card-summary">{{illustrated && guide.caseNote ? guide.caseNote : guide.summary}}</view>
  </view>
  <text wx:if="{{!illustrated}}" class="card-arrow">›</text>
</navigator>
