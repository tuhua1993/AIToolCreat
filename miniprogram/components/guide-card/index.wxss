.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 15rpx;
  padding: 24rpx;
  border: 1rpx solid #e6e5e1;
  border-radius: 21rpx;
  background: #fff;
}
.card-main { min-width: 0; }
.card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; color: #5e6275; font-size: 22rpx; }
.tag { padding: 3rpx 10rpx; border-radius: 7rpx; font-weight: 650; }
.tag.blue { background: #e8edff; color: #2844b6; }
.tag.lilac { background: #efe9fb; color: #6747a4; }
.tag.peach { background: #faebe2; color: #934633; }
.tag.teal { background: #e1f1ec; color: #176b60; }
.card-title { margin: 8rpx 0 5rpx; color: #1e2539; font-size: 29rpx; font-weight: 710; line-height: 1.4; }
.card-summary { color: #565b6d; font-size: 25rpx; line-height: 1.54; }
.card-arrow { flex: 0 0 auto; color: #485ab8; font-size: 36rpx; line-height: 1; }
.pressed { opacity: .72; }


.card.illustrated { gap: 9px; min-height: 101px; margin: 0; padding: 15px 0; border: 0; border-bottom: 1px solid #e9e9e9; border-radius: 0; background: #fff; }
.illustrated .card-main { flex: 1; }
.illustrated .card-title { margin: 0 0 4px; color: #1a1b1e; font-size: 16px; line-height: 1.4; font-weight: 700; }
.illustrated .card-summary { color: #66676b; font-size: 13px; line-height: 1.5; }
.card-cover { display: flex; flex: 0 0 87px; align-items: center; justify-content: center; overflow: hidden; width: 87px; height: 66px; border-radius: 13px; background: #f0f0f2; }
.cover-photo { display: block; width: 100%; height: 100%; }
.cover-icon { width: 32px; height: 32px; }
.laptop { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; background: linear-gradient(142deg, #fafafa, #e1e4e5 70%, #bbc0c4); }
.laptop-screen { width: 63px; height: 40px; border: 2px solid #27282a; border-bottom-width: 3px; border-radius: 3px 3px 1px 1px; background: white; }
.laptop-base { width: 77px; height: 3px; border-radius: 1px 1px 70% 70%; background: linear-gradient(#e8ebeb,#767a7e); box-shadow: 0 2px 3px #888a91; }
