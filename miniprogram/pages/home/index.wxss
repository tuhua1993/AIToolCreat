.shell.home { max-width: 644px; margin: 0 auto; padding: 6px 11px 25px; }
.creator-stage { padding: 14px; border-radius: 14px; background: linear-gradient(180deg, #626575 0%, #303447 9%, #191e34 25%); }
.stage-title { color: #fff; font-size: 25px; line-height: 1.35; font-weight: 700; }
.stage-note { margin-top: 7px; color: #b4bed8; font-size: 13px; line-height: 1.55; }
.topic-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; margin-top: 10px; }
.topic-card { display: flex; width: 100%; min-height: 66px; flex-direction: column; justify-content: center; align-items: center; gap: 7px; padding: 8px 3px; border-radius: 10px; background: #f6f6f6; color: #202124; font-size: 14px; line-height: 1.4; }
.topic-icon { display: block; width: 21px; height: 21px; }
.home-section { margin-top: 11px; }
.home .section-title { color: #1c1d20; font-size: 16px; line-height: 1.5; font-weight: 700; }
.tool-section { margin-top: 20px; }
.section-bar, .tool-link { display: flex; align-items: center; justify-content: space-between; }
.section-link, .about-link { color: #6956bd; font-size: 14px; }
.section-link { min-height: 44px; }
.tool-link { width: 100%; padding: 12px 0; border-bottom: 1px solid #eee; color: #303039; text-align: left; font-size: 15px; }
.tool-link text { color: #777382; }
.about-link { padding: 18px 0 8px; text-align: center; }
