.hero {
  position: relative;
  overflow: hidden;
  min-height: 376rpx;
  border: 1rpx solid #423b60;
  border-radius: 30rpx;
  background: #211b36;
}

.hero-image, .hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(90deg, rgba(19, 16, 36, .94), rgba(22, 18, 40, .48) 49%, rgba(22, 18, 40, 0) 80%);
}

.hero-content { position: relative; padding: 32rpx 30rpx; }
.hero-label { display: flex; align-items: center; gap: 11rpx; color: #ddd5f5; font-size: 23rpx; }
.hero-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #cbf891; box-shadow: 0 0 18rpx #9ae06b; }
.hero-heading { margin-top: 14rpx; font-size: 60rpx; font-weight: 780; letter-spacing: -2rpx; line-height: 1.13; }
.hero-accent { display: block; color: #cbf891; }
.hero-description { margin-top: 12rpx; color: #ddd5e9; font-size: 25rpx; }
.hero-action { display: inline-flex; min-height: 66rpx; margin-top: 22rpx; padding: 10rpx 23rpx; border-radius: 18rpx; }
.hero-arrow { margin-left: 14rpx; font-size: 29rpx; }
.home-search { width: 100%; margin: 22rpx 0 32rpx; color: #b9bbd0; font-size: 25rpx; }

.section-bar { display: flex; align-items: center; justify-content: space-between; min-height: 48rpx; margin-bottom: 16rpx; }
.section-link { display: flex; align-items: center; gap: 9rpx; color: #cbf891; font-size: 24rpx; }
.section-link text, .about-link text { font-size: 34rpx; line-height: 1; }
.topic-grid { display: flex; flex-wrap: wrap; margin: -7rpx; }

.topic-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: calc(50% - 14rpx);
  min-height: 107rpx;
  margin: 7rpx;
  padding: 13rpx;
  border: 1rpx solid #2c2f46;
  border-radius: 20rpx;
  background: #1a1c2e;
  text-align: left;
}

.topic-icon {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
}

.topic-icon image { width: 37rpx; height: 37rpx; }
.tone-lime { background: #2a382e; }
.tone-violet { background: #322b48; }
.tone-rose { background: #3b283d; }
.tone-cyan { background: #23343f; }
.topic-copy { min-width: 0; }
.topic-name { font-size: 26rpx; line-height: 1.3; font-weight: 700; }
.topic-subtitle { margin-top: 4rpx; color: #adafc6; font-size: 20rpx; line-height: 1.35; }
.featured-heading { margin-top: 34rpx; }
.about-link { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 32rpx; color: #adafc6; font-size: 25rpx; }
