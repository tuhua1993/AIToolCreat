.home { padding-top: 18rpx; }

.hero {
  position: relative;
  overflow: hidden;
  min-height: 405rpx;
  border: 1rpx solid #e9e4d9;
  border-radius: 28rpx;
  background: #f5efe3;
}

.hero-image, .hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(90deg, rgba(248, 243, 233, .48), rgba(248, 243, 233, .13) 48%, rgba(248, 243, 233, 0) 65%);
}

.hero-content { position: relative; padding: 38rpx 33rpx 34rpx; }
.hero-label { color: #525874; font-size: 24rpx; font-weight: 600; letter-spacing: 1rpx; }
.hero-heading { margin: 16rpx 0 25rpx; color: #192139; font-size: 67rpx; font-weight: 760; letter-spacing: -3rpx; line-height: 1.12; }
.hero-accent { display: block; color: #2844c7; }
.hero-action { display: inline-flex; min-height: 69rpx; padding: 10rpx 22rpx; border-radius: 14rpx; }
.hero-arrow { margin-left: 12rpx; font-size: 29rpx; }
.hero-credit { position: absolute; right: 15rpx; bottom: 12rpx; padding: 2rpx 9rpx; border-radius: 7rpx; background: #faf9f4; color: #555870; font-size: 19rpx; }
.home-search { width: 100%; margin: 18rpx 0; color: #565b6d; font-size: 27rpx; }
.search-arrow { margin-left: auto; color: #686d83; font-size: 36rpx; line-height: 1; }

.starter { display: flex; align-items: center; gap: 17rpx; padding: 18rpx; border: 1rpx solid #dce2ff; border-radius: 22rpx; background: #edf0ff; }
.starter-icon { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 15rpx; background: #fff; }
.starter-icon image { width: 38rpx; height: 38rpx; }
.starter-copy { flex: 1; min-width: 0; }
.starter-label { margin-bottom: 2rpx; color: #484f78; font-size: 22rpx; }
.starter-title { color: #202a50; font-size: 27rpx; font-weight: 700; line-height: 1.34; }
.starter-arrow { margin: 0 7rpx; color: #2844c7; font-size: 31rpx; line-height: 1; }

.topic-heading { margin: 29rpx 0 17rpx; }
.topic-grid { display: flex; flex-wrap: wrap; row-gap: 9rpx; }
.topic-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; width: 25%; min-height: 113rpx; padding: 5rpx 2rpx; background: transparent; }
.topic-icon { display: flex; align-items: center; justify-content: center; width: 65rpx; height: 65rpx; border-radius: 18rpx; }
.topic-icon image { width: 42rpx; height: 42rpx; }
.tone-blue { background: #e8edff; }
.tone-lilac { background: #efe9fb; }
.tone-peach { background: #faebe2; }
.tone-teal { background: #e1f1ec; }
.topic-name { color: #252b43; font-size: 23rpx; line-height: 1.28; font-weight: 650; }
.updates-heading { margin: 28rpx 0 15rpx; }
.about-link { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 68rpx; margin-top: 20rpx; color: #565b6d; font-size: 25rpx; }
.about-link text { font-size: 34rpx; line-height: 1; }
