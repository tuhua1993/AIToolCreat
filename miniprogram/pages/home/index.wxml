<view class="shell home">
  <view class="creator-stage">
    <view class="stage-title">今天你想用AI做什么？</view>
    <view class="stage-note">真实案例 · 工具实测 · 低成本创作</view>
  </view>

  <view class="topic-grid">
    <button wx:for="{{creationTopics}}" wx:key="id" class="topic-card" data-category="{{item.id}}" bindtap="openTopic" hover-class="tap">
      <image class="topic-icon" src="/assets/actions/{{item.icon}}.png" mode="aspectFit" />
      <text>{{item.action}}</text>
    </button>
  </view>

  <view class="home-section">
    <view class="section-title">最新实战案例</view>
    <guide-card wx:for="{{recent}}" wx:key="id" guide="{{item}}" illustrated="{{true}}"></guide-card>
    <view wx:if="{{coverNote}}" class="cover-note">{{coverNote}}</view>
  </view>

  <view class="tool-section">
    <view class="section-bar">
      <view class="section-title">工具教程</view>
      <button class="section-link" bindtap="search" hover-class="tap">搜索教程</button>
    </view>
    <button class="tool-link" data-category="tools" bindtap="openTopic" hover-class="tap">WorkBuddy、豆包和 Grok<text>›</text></button>
    <button class="tool-link" data-category="code" bindtap="openTopic" hover-class="tap">Codex 编程实战<text>›</text></button>
    <button class="tool-link" data-category="overseas" bindtap="openTopic" hover-class="tap">短剧出海与字幕<text>›</text></button>
  </view>
  <navigator class="about-link" url="/pages/about/index" hover-class="tap">关于创作玩家</navigator>
</view>
