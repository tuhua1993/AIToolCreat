<view class="masthead" style="padding-top: {{statusBar}}px;">
  <view class="masthead-row" style="height: {{menuHeight}}px;">
    <view class="brand-mark" aria-hidden="true"><view></view><view></view><view></view></view>
    <text class="brand-title">创作玩家</text>
  </view>
</view>

<view class="shell home">
  <view class="creator-stage">
    <image class="stage-image" src="/assets/creator-stage.jpg" mode="aspectFill" />
    <view class="stage-shade"></view>
    <view class="stage-content">
      <view class="stage-title">今天想用 AI<text>做点什么？</text></view>
      <view class="stage-note">工具清单 · 制作预算 · 实操流程</view>
    </view>
    <text class="stage-credit">AI 生成插画</text>
  </view>

  <view class="topic-grid">
    <button
      wx:for="{{creationTopics}}" wx:key="id"
      class="topic-card topic-{{item.tone}}" data-category="{{item.id}}" bindtap="openTopic" hover-class="tap"
    >
      <image class="topic-icon" src="/assets/{{item.icon}}.png" mode="aspectFit" />
      <text>{{item.action}}</text>
    </button>
  </view>

  <view class="home-section">
    <view class="section-bar">
      <view class="section-title">最新实战</view>
      <button class="section-link" bindtap="openCases" hover-class="tap">全部案例 <text>›</text></button>
    </view>
    <guide-card wx:for="{{recent}}" wx:key="id" guide="{{item}}" illustrated="{{true}}"></guide-card>
    <view class="cover-credit">漫剧画面与歌曲封面由 AI 生成</view>
  </view>

  <view class="home-section">
    <view class="section-bar">
      <view class="section-title">工具教程</view>
      <button class="section-link" bindtap="search" hover-class="tap"><view class="search-icon"></view>搜索</button>
    </view>
    <button class="tool-link" data-category="tools" bindtap="openTopic" hover-class="tap">
      <image src="/assets/spark.png" mode="aspectFit" />
      <text>WorkBuddy、豆包和 Grok</text>
      <text class="tool-arrow">›</text>
    </button>
    <button class="tool-link" data-category="code" bindtap="openTopic" hover-class="tap">
      <image src="/assets/code.png" mode="aspectFit" />
      <text>Codex 编程实战</text>
      <text class="tool-arrow">›</text>
    </button>
  </view>

  <navigator class="about-link" url="/pages/about/index" hover-class="tap">关于创作玩家 <text>›</text></navigator>
</view>
