.detail { padding-top: 29rpx; }
.detail-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-bottom: 16rpx; color: #565b6d; font-size: 24rpx; }
.detail-topic { padding: 4rpx 15rpx; border-radius: 9rpx; background: #e8edff; color: #2844b6; font-weight: 650; }
.detail-title { font-size: 50rpx; line-height: 1.23; letter-spacing: -1rpx; }
.detail-intro { margin: 12rpx 0 15rpx; font-size: 29rpx; }
.detail-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10rpx; margin-bottom: 26rpx; }
.updated-on { color: #5e6275; font-size: 24rpx; }
.save-button { min-height: 67rpx; padding: 10rpx 18rpx; border: 1rpx solid #d9def4; border-radius: 14rpx; background: #fff; color: #2844b6; font-size: 25rpx; }
.save-button.is-saved { border-color: #cbd4fb; background: #e8edff; font-weight: 650; }
.outcome { padding: 22rpx 24rpx; border-left: 6rpx solid #2844c7; border-radius: 13rpx; background: #edf0ff; color: #263053; font-size: 28rpx; }
.outcome-label { margin-bottom: 4rpx; color: #2844b6; font-size: 24rpx; font-weight: 700; }
.detail-heading { margin: 36rpx 0 4rpx; }
.step { display: flex; gap: 17rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e7e5de; }
.step-number { display: flex; flex: 0 0 49rpx; align-items: center; justify-content: center; width: 49rpx; height: 49rpx; border-radius: 13rpx; background: #e8edff; color: #2844b6; font-size: 24rpx; font-weight: 750; }
.step-copy { flex: 1; min-width: 0; }
.step-title { font-size: 30rpx; font-weight: 700; }
.step-body { margin-top: 6rpx; color: #42495e; font-size: 29rpx; line-height: 1.73; }
.step-figure { overflow: hidden; margin-top: 15rpx; border: 1rpx solid #e2e5f0; border-radius: 17rpx; background: #fff; }
.figure-image { display: block; width: 100%; }
.figure-caption { padding: 12rpx 15rpx; color: #565b6d; font-size: 23rpx; }
.figure-viewer { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; padding: 14rpx; background: #faf9f5; }
.figure-large { width: 100%; height: 66vh; }
.figure-close { padding: 14rpx 28rpx; border: 1rpx solid #d9def4; border-radius: 17rpx; background: #fff; color: #2844b6; font-size: 28rpx; }
.prompt-card { margin-top: 30rpx; padding: 25rpx; border: 1rpx solid #e3dece; border-radius: 19rpx; background: #f5f1e5; }
.prompt-header { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.prompt-title { font-size: 30rpx; }
.copy { min-height: 61rpx; padding: 6rpx 20rpx; border: 1rpx solid #dcd7c8; border-radius: 11rpx; background: #fff; color: #2844b6; font-size: 25rpx; font-weight: 650; }
.prompt-text { color: #41485d; font-size: 28rpx; line-height: 1.73; }
.check { margin: 27rpx 0; color: #42495e; font-size: 28rpx; }
.check-title { margin-bottom: 3rpx; color: #2448a8; }
.detail-actions { display: flex; gap: 14rpx; }
.detail-actions button { flex: 1; }
.secondary-button { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 12rpx 22rpx; border: 1rpx solid #d9def4; border-radius: 17rpx; background: #fff; color: #2844b6; font-size: 26rpx; font-weight: 700; }
