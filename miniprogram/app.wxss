page {
  background: #101220;
  color: #f4f3fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view, text, image, navigator, input, button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
}

button::after { border: 0; }

.shell { padding: 20rpx 32rpx 56rpx; }
.page-heading { margin: 4rpx 0 6rpx; font-size: 52rpx; line-height: 1.24; font-weight: 750; }
.page-intro { margin-bottom: 30rpx; color: #adafc6; font-size: 27rpx; }
.section-title { font-size: 35rpx; line-height: 1.3; font-weight: 720; }
.muted { color: #adafc6; }
.lime { color: #cbf891; }
.tap { opacity: .72; }

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  padding: 12rpx 26rpx;
  border-radius: 20rpx;
  background: #cbf891;
  color: #182418;
  font-size: 26rpx;
  font-weight: 700;
}

.search-box {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 0 22rpx;
  gap: 16rpx;
  border: 1rpx solid #303248;
  border-radius: 22rpx;
  background: #191b2d;
  text-align: left;
}

.search-icon {
  position: relative;
  flex: 0 0 25rpx;
  width: 25rpx;
  height: 25rpx;
  margin-right: 4rpx;
  border: 3rpx solid #b9bbd0;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #b9bbd0;
  transform: rotate(45deg);
  content: "";
}

.empty-state {
  padding: 52rpx 26rpx;
  border: 1rpx solid #303248;
  border-radius: 24rpx;
  background: #191b2d;
  text-align: center;
}

.empty-title { font-size: 32rpx; font-weight: 700; }
.empty-body { margin: 8rpx 0 24rpx; color: #adafc6; }
.empty-state .primary-button { display: inline-flex; }
